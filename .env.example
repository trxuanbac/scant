# AI REPORT STUDIO VIP PRO - Environment Configuration

# Service & Environment
PROJECT_NAME="AI Report Studio VIP Pro"
ENVIRONMENT="development"
DEBUG=true

# Database
# Local SQLite fallback:
DATABASE_URL="sqlite+aiosqlite:///./storage/ai_report_studio.db"
AUTO_MIGRATE_DATABASE=true
# Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_report_studio"
# AUTO_MIGRATE_DATABASE=false

# Security
JWT_SECRET="change_me_to_a_strong_random_secret_min_32_chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Keys
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
DEFAULT_AI_PROVIDER="gemini"
DEFAULT_AI_MODEL="gemini-2.5-flash"

# Search & Research Keys
SEARCH_PROVIDER="tavily"
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SERPAPI_API_KEY=""

# Frontend URL & Backend Ports
NEXT_PUBLIC_API_URL="http://localhost:8050/api/v1"
CORS_ORIGINS='["http://localhost:3050","http://127.0.0.1:3050"]'

# Google Cloud OAuth (Authorized Redirect: http://localhost:3050/api/auth/callback/google)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3050/api/auth/callback/google"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
